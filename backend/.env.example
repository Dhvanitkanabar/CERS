# ==============================================================
# CERS+ EMERGENCY INTELLIGENCE BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================

# Server Port
PORT=5001
NODE_ENV=development

# --------------------------------------------------------------
# Adaption Labs Configuration
# Get your API key from: https://adaptionlabs.ai/app (Settings > API Keys)
# --------------------------------------------------------------
ADAPTION_API_KEY=your_adaption_api_key_here
ADAPTION_MODEL=qwen3.5-397b
ADAPTION_API_BASE_URL=https://api.prod.adaptionlabs.ai/api/v1
ADAPTION_TIMEOUT_MS=25000

# --------------------------------------------------------------
# Google Gemini Configuration (Fallback & Medical Assistant)
# --------------------------------------------------------------
GEMINI_API_KEY=AIzaSyCLFHS0iq15OzWFKJcOOlD925NhKyu3mOc
GEMINI_MODEL=gemini-1.5-flash

# --------------------------------------------------------------
# MongoDB Configuration (Optional - falls back to in-memory store)
# --------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/cers_plus

# --------------------------------------------------------------
# AI Provider Strategy: 'adaption' | 'gemini' | 'auto'
# 'auto' prioritizes Adaption Labs, with graceful Gemini fallback
# --------------------------------------------------------------
DEFAULT_AI_PROVIDER=auto
